<view class="container">
  <!-- 欢迎/起始页 -->
  <view class="welcome" wx:if="{{!hasStarted}}">
    <view class="welcome-decoration">
      <view class="welcome-circle"></view>
      <image class="welcome-icon" src="../../images/header-icon.svg" mode="aspectFit" />
    </view>
    <text class="welcome-title">🌸 好孕日记</text>
    <text class="welcome-subtitle">记录孕期点滴，陪伴幸福时光</text>

    <view class="card start-card">
      <text class="start-label">嗨，怎么称呼你？</text>
      <text class="start-hint">给自己取个暖暖的昵称吧</text>
      <input class="name-input" placeholder="例如：小甜心、准妈妈、乐乐妈..." maxlength="10" value="{{userName}}" bindinput="onNameInput" />
      <view class="start-divider"></view>
      <text class="start-label">怀孕第一天</text>
      <text class="start-hint">即末次月经的第一天</text>
      <picker mode="date" value="{{firstDay}}" start="2020-01-01" end="{{today}}" bindchange="onDateChange">
        <view class="date-selector {{firstDay ? 'active' : ''}}">
          <image class="date-icon" src="../../images/calendar.svg" mode="aspectFit" />
          <text class="date-text">{{firstDay || '点击选择日期'}}</text>
        </view>
      </picker>
      <button class="btn-start" bindtap="saveDate" disabled="{{!firstDay || !userName}}">
        <text wx:if="{{!firstDay || !userName}}">请填写信息后开始</text>
        <text wx:if="{{firstDay && userName}}">✨ 开始记录</text>
      </button>
    </view>
  </view>

  <!-- 主界面 -->
  <view class="main" wx:if="{{hasStarted}}">
    <!-- 产检提醒横幅 -->
    <view class="alert-banner {{alertBanner.type}}" wx:if="{{alertBanner && !bannerDismissed}}" bindtap="scrollToChecks">
      <text class="alert-icon">{{alertBanner.icon}}</text>
      <view class="alert-text">
        <text class="alert-title">{{alertBanner.title}}</text>
        <text class="alert-sub">{{alertBanner.sub}}</text>
      </view>
      <text class="alert-arrow">›</text>
      <view class="alert-close" catchtap="dismissBanner">✕</view>
    </view>

    <!-- 顶部孕期卡片 -->
    <view class="hero-card {{eggKick ? 'hero-kick' : ''}}" bindtap="onHeroTap">
      <view class="hero-bg"></view>
      <view class="hero-content" catchtap="onHeroTap">
        <view class="hero-top">
          <view class="hero-greeting-wrap">
            <text class="hero-greeting">{{greetingText}}，{{userName}}</text>
            <text class="hero-blessing">{{blessingText}}</text>
          </view>
          <picker mode="date" value="{{firstDay}}" start="2020-01-01" end="{{today}}" bindchange="onFirstDayChange">
            <view class="hero-edit-btn">修改</view>
          </picker>
        </view>
        <view class="hero-week">
          <text class="hero-week-num">{{pregnancyInfo.week}}</text>
          <text class="hero-week-unit">周</text>
          <text class="hero-day-num">{{pregnancyInfo.day}}</text>
          <text class="hero-day-unit">天</text>
        </view>
        <view class="hero-progress">
          <view class="hero-progress-bar">
            <view class="hero-progress-fill" style="width:{{pregnancyInfo.progress}}%"></view>
          </view>
          <text class="hero-progress-text">{{pregnancyInfo.progress}}%</text>
        </view>
        <view class="hero-baby" wx:if="{{babySize.size}}">
          <text class="hero-baby-icon">{{babySize.emoji}}</text>
          <view class="hero-baby-info">
            <text class="hero-baby-text">像一颗{{babySize.size}} {{babySize.desc}}</text>
            <text class="hero-baby-develop" wx:if="{{babySize.develop}}">{{babySize.develop}}</text>
          </view>
        </view>
      </view>
      <!-- 彩蛋气泡（JS 正弦驱动） -->
      <view class="egg-bubble {{eggBurst ? 'egg-bursting' : ''}}" style="{{eggStyle}}" wx:if="{{eggVisible}}" catchtap="onHeroTap">
        <view class="egg-highlight"></view>
        <text class="egg-text">{{eggText}}</text>
      </view>
    </view>

    <!-- 快捷信息 -->
    <view class="quick-grid">
      <view class="quick-item">
        <view class="quick-icon quick-icon-pink">
          <text class="quick-emoji">{{stageEmoji}}</text>
        </view>
        <text class="quick-label">当前阶段</text>
        <text class="quick-value">{{pregnancyInfo.period}}</text>
      </view>
      <view class="quick-item">
        <view class="quick-icon quick-icon-purple">
          <text class="quick-emoji">🎂</text>
        </view>
        <text class="quick-label">预产期</text>
        <text class="quick-value">{{pregnancyInfo.dueDate}}</text>
      </view>
      <view class="quick-item">
        <view class="quick-icon quick-icon-orange">
          <text class="quick-emoji">🤰</text>
        </view>
        <text class="quick-label">已怀孕</text>
        <text class="quick-value">{{pregnancyInfo.elapsedDays}} 天</text>
      </view>
      <view class="quick-item">
        <view class="quick-icon quick-icon-green">
          <text class="quick-emoji">⏳</text>
        </view>
        <text class="quick-label">剩余天数</text>
        <text class="quick-value">{{pregnancyInfo.remainingDays}} 天</text>
      </view>
    </view>

    <!-- 孕周日期对照 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">📅 孕周日期对照</text>
        <text class="section-date">滑动查看 · 点击显示完整日期</text>
      </view>
      <scroll-view class="week-scroll" scroll-x="{{true}}" scroll-into-view="{{scrollWeekId}}"
                   scroll-with-animation="{{true}}" show-scrollbar="{{false}}">
        <view class="week-strip">
          <view wx:for="{{weekList}}" wx:key="week"
                id="{{item.id}}"
                class="week-item stage-{{item.stage}} {{item.current ? 'week-current' : ''}}"
                data-week="{{item.week}}" bindtap="onWeekItemTap">
            <view class="week-item-tag" wx:if="{{item.current}}">本周</view>
            <text class="week-item-title">{{item.week}}周</text>
            <text class="week-item-date">{{item.short}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 产检时间表 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">📋 产检时间表</text>
        <text class="section-date">{{todayDate}}</text>
      </view>

      <view class="check-group" wx:if="{{checkItems.length > 0}}">
        <view class="check-group-header">
          <text class="check-group-dot urgent-dot"></text>
          <text class="check-group-title">当前需做</text>
          <text class="check-group-count">{{checkItems.length}}</text>
        </view>
        <view class="check-card-item {{item.required ? 'required-item' : ''}}" wx:for="{{checkItems}}" wx:key="index" data-name="{{item.name}}" bindtap="toggleCheckItem">
          <view class="check-left">
            <view class="check-status {{item.urgent ? 'status-urgent' : ''}}">
              <text class="status-icon">{{item.urgent ? '❗' : '●'}}</text>
            </view>
          </view>
          <view class="check-center">
            <view class="check-name-row">
              <text wx:if="{{!item.required}}" class="optional-badge">可选</text>
              <text class="check-name-text">{{item.name}}</text>
            </view>
            <text class="check-date-text">{{item.dateRange}}</text>
            <text class="check-desc-text">{{item.desc}}</text>
          </view>
          <view class="check-right">
            <view class="check-done-btn">
              <text class="done-btn-icon">✓</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 可折叠的分组 -->
      <view class="check-group" wx:if="{{overdueChecks.length > 0}}">
        <view class="check-group-header check-collapsible" data-group="overdue" bindtap="toggleGroup">
          <view class="check-group-dot overdue-dot"></view>
          <text class="check-group-title">已过期未做</text>
          <text class="check-group-count">{{overdueChecks.length}}</text>
          <text class="group-arrow {{expandedGroups.overdue ? 'arrow-down' : 'arrow-right'}}">›</text>
        </view>
        <block wx:if="{{expandedGroups.overdue}}">
          <view class="check-card-item check-overdue" wx:for="{{overdueChecks}}" wx:key="index" data-name="{{item.name}}" bindtap="toggleCheckItem">
            <view class="check-left">
              <view class="check-status status-overdue">
                <text class="status-icon">⚠️</text>
              </view>
            </view>
            <view class="check-center">
              <view class="check-name-row">
                <text class="check-name-text">{{item.name}}</text>
              </view>
              <text class="check-date-text">{{item.dateRange}}</text>
              <text class="check-deadline-text overdue-deadline">{{item.deadline}}</text>
              <text class="check-desc-text">{{item.desc}}</text>
            </view>
            <view class="check-right">
              <view class="check-done-btn">
                <text class="done-btn-icon">✓</text>
              </view>
            </view>
          </view>
        </block>
      </view>

      <view class="check-group" wx:if="{{upcomingChecks.length > 0}}">
        <view class="check-group-header check-collapsible" data-group="upcoming" bindtap="toggleGroup">
          <view class="check-group-dot upcoming-dot"></view>
          <text class="check-group-title">即将到来</text>
          <text class="check-group-count">{{upcomingChecks.length}}</text>
          <text class="group-arrow {{expandedGroups.upcoming ? 'arrow-down' : 'arrow-right'}}">›</text>
        </view>
        <block wx:if="{{expandedGroups.upcoming}}">
          <view class="check-card-item check-upcoming {{item.required ? 'required-item' : ''}}" wx:for="{{upcomingChecks}}" wx:key="index">
            <view class="check-left">
              <view class="check-status status-upcoming">
                <text class="status-icon">○</text>
              </view>
            </view>
            <view class="check-center">
              <view class="check-name-row">
                <text wx:if="{{!item.required}}" class="optional-badge">可选</text>
                <text class="check-name-text">{{item.name}}</text>
              </view>
              <text class="check-date-text">{{item.dateRange}}</text>
              <text class="check-deadline-text">{{item.deadline}}</text>
              <text class="check-desc-text">{{item.desc}}</text>
            </view>
          </view>
        </block>
      </view>

      <view class="check-group" wx:if="{{completedChecksList.length > 0}}">
        <view class="check-group-header check-collapsible" data-group="done" bindtap="toggleGroup">
          <view class="check-group-dot done-dot"></view>
          <text class="check-group-title">已完成</text>
          <text class="check-group-count">{{completedChecksList.length}}</text>
          <text class="group-arrow {{expandedGroups.done ? 'arrow-down' : 'arrow-right'}}">›</text>
        </view>
        <block wx:if="{{expandedGroups.done}}">
          <view class="check-card-item check-done" wx:for="{{completedChecksList}}" wx:key="index" data-name="{{item.name}}" bindtap="toggleCheckItem">
            <view class="check-left">
              <view class="check-status status-done">
                <text class="status-icon">✓</text>
              </view>
            </view>
            <view class="check-center">
              <view class="check-name-row">
                <text wx:if="{{!item.required}}" class="optional-badge">可选</text>
                <text class="check-name-text done-text">{{item.name}}</text>
              </view>
              <text class="check-date-text done-text">{{item.dateRange}}</text>
            </view>
            <view class="check-right">
              <view class="check-undo-btn">
                <text class="undo-text">撤销</text>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>

    <!-- 底部操作 -->
    <view class="bottom-actions">
      <view class="bottom-action" bindtap="showFeedback">
        <text class="bottom-action-icon">💬</text>
        <text class="bottom-action-text">反馈</text>
      </view>
      <view class="bottom-action-divider"></view>
      <view class="bottom-action" bindtap="resetDate">
        <text class="bottom-action-icon">♻️</text>
        <text class="bottom-action-text">重置</text>
      </view>
    </view>
  </view>

  <!-- 意见反馈抽屉 -->
  <view class="fb-mask" wx:if="{{showFeedbackSheet}}" bindtap="closeFeedbackSheet">
    <view class="fb-sheet" catchtap="noop">
      <view class="fb-handle"></view>
      <text class="fb-title">意见反馈</text>
      <text class="fb-sub">你的建议会让好孕日记变得更好 💕</text>

      <view class="fb-tags">
        <view class="fb-tag {{selectedTagIndex === index ? 'fb-tag-active' : ''}}"
              wx:for="{{feedbackTags}}" wx:key="label"
              data-index="{{index}}" bindtap="onSelectFeedbackTag">{{item.label}}</view>
      </view>

      <view class="fb-input-wrap">
        <textarea class="fb-textarea" placeholder="说说你的想法或遇到的问题..."
                  placeholder-class="fb-placeholder" value="{{feedbackText}}"
                  bindinput="onFeedbackInput" maxlength="200"
                  show-confirm-bar="{{false}}" disable-default-padding="{{true}}"></textarea>
        <text class="fb-count {{feedbackText.length >= 180 ? 'fb-count-warn' : ''}}">{{feedbackText.length}} / 200</text>
      </view>

      <button class="fb-submit-btn" bindtap="submitFeedback" disabled="{{!feedbackText || feedbackSubmitting}}">
        {{feedbackSubmitting ? '提交中...' : '提交反馈'}}
      </button>
      <view class="fb-cancel" bindtap="closeFeedbackSheet">取消</view>
    </view>
  </view>
</view>
