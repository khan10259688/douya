/* ========== 页面容器 ========== */
.container {
  padding: 0 24rpx 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ========== 欢迎页 ========== */
.welcome {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
}

.welcome-decoration {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.welcome-circle {
  position: absolute;
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, #FFE0E6, #FFF0F5);
  border-radius: 50%;
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.05); opacity: 0.8; }
}

.welcome-icon {
  width: 140rpx;
  height: 140rpx;
  z-index: 1;
}

.welcome-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #FF6B81;
  margin-top: 12rpx;
}

.welcome-subtitle {
  font-size: 26rpx;
  color: #B0A0A0;
  margin-top: 8rpx;
  letter-spacing: 2rpx;
}

/* 开始卡片 */
.start-card {
  width: 100%;
  margin-top: 60rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(255, 107, 129, 0.1);
}

.start-label {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  display: block;
}

.start-hint {
  font-size: 26rpx;
  color: #B0A0A0;
  display: block;
  margin-top: 8rpx;
  margin-bottom: 24rpx;
}

.start-divider {
  height: 2rpx;
  background: #FFE8EC;
  margin: 24rpx 0 28rpx;
}

.name-input {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #FFF5F7, #FFFAFB);
  border: 2rpx solid #FFDCE0;
  border-radius: 20rpx;
  padding: 0 28rpx;
  font-size: 32rpx;
  color: #FF6B81;
  font-weight: 500;
  box-sizing: border-box;
  margin-bottom: 8rpx;
}

.name-input::placeholder {
  color: #D0C0C0;
  font-weight: 400;
}

.date-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FFF5F7, #FFFAFB);
  border: 2rpx solid #FFDCE0;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 32rpx;
  gap: 12rpx;
}

.date-selector.active {
  border-color: #FF6B81;
  background: linear-gradient(135deg, #FFF0F2, #FFF5F7);
}

.date-icon {
  width: 40rpx;
  height: 40rpx;
}

.date-text {
  font-size: 32rpx;
  color: #FF6B81;
  font-weight: 500;
}

.btn-start {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #FF6B81, #FF8A9E);
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 48rpx;
  text-align: center;
  box-shadow: 0 6rpx 24rpx rgba(255, 107, 129, 0.3);
}

.btn-start[disabled] {
  background: #F0E0E0;
  box-shadow: none;
  color: #CCC;
}

/* ========== 主界面 ========== */
.main {
  padding-top: 20rpx;
}

/* ========== 顶部孕期卡片 ========== */
.hero-card {
  position: relative;
  border-radius: 32rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 129, 0.15);
}

.hero-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, #FF6B81 0%, #FF8A9E 40%, #FF9AAE 100%);
}

.hero-content {
  position: relative;
  padding: 36rpx 32rpx 32rpx;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.hero-greeting-wrap {
  flex: 1;
}

.hero-greeting {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 600;
  display: block;
}

.hero-blessing {
  font-size: 24rpx;
  color: rgba(255,255,255,0.75);
  display: block;
  margin-top: 6rpx;
  line-height: 1.5;
}

.hero-edit-btn {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  background: rgba(255,255,255,0.2);
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
}

.hero-week {
  display: flex;
  align-items: baseline;
  justify-content: center;
  padding: 10rpx 0 16rpx;
}

.hero-week-num {
  font-size: 96rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1;
}

.hero-week-unit {
  font-size: 32rpx;
  color: rgba(255,255,255,0.9);
  margin-left: 6rpx;
  margin-right: 16rpx;
}

.hero-day-num {
  font-size: 56rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.95);
  line-height: 1;
}

.hero-day-unit {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
  margin-left: 4rpx;
}

.hero-progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hero-progress-bar {
  flex: 1;
  height: 10rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 5rpx;
  overflow: hidden;
}

.hero-progress-fill {
  height: 100%;
  background: #FFFFFF;
  border-radius: 5rpx;
  transition: width 0.5s ease;
}

.hero-progress-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
  font-weight: 500;
  min-width: 60rpx;
  text-align: right;
}

.hero-baby {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 18rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 20rpx;
  padding: 12rpx 20rpx;
}

.hero-baby-icon {
  font-size: 32rpx;
}

.hero-baby-text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.9);
}

/* ========== 快捷信息 ========== */
.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.quick-item {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.quick-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.quick-icon-pink { background: #FFF0F3; }
.quick-icon-purple { background: #F3EFFF; }
.quick-icon-orange { background: #FFF5ED; }
.quick-icon-green { background: #EDFFF5; }

.quick-emoji {
  font-size: 32rpx;
}

.quick-label {
  font-size: 22rpx;
  color: #B0A0A0;
  display: block;
  margin-bottom: 6rpx;
}

.quick-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #FF6B81;
  display: block;
}

/* ========== 孕周日期对照 ========== */
.week-scroll {
  width: 100%;
  white-space: nowrap;
}

.week-strip {
  display: inline-flex;
  gap: 14rpx;
  padding: 16rpx 4rpx 8rpx;
}

.week-item {
  position: relative;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 140rpx;
  padding: 18rpx 14rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
  flex-shrink: 0;
  box-sizing: border-box;
}

.week-item:active {
  transform: scale(0.96);
}

.stage-early {
  border: 2rpx solid #FFDCE0;
}

.stage-mid {
  border: 2rpx solid #E3D9FF;
}

.stage-late {
  border: 2rpx solid #FFE3C4;
}

.week-item-title {
  font-size: 26rpx;
  font-weight: 700;
}

.stage-early .week-item-title {
  color: #FF6B81;
}

.stage-mid .week-item-title {
  color: #9B59B6;
}

.stage-late .week-item-title {
  color: #FF9F43;
}

.week-item-date {
  font-size: 20rpx;
  color: #B0A0A0;
  margin-top: 6rpx;
}

.week-current {
  background: linear-gradient(135deg, #FF6B81, #FF8A9E);
  border: 2rpx solid #FF6B81;
  box-shadow: 0 6rpx 18rpx rgba(255, 107, 129, 0.35);
  transform: scale(1.06);
}

.week-current .week-item-title,
.week-current .week-item-date {
  color: #FFFFFF;
}

.week-item-tag {
  position: absolute;
  top: -14rpx;
  right: -6rpx;
  font-size: 18rpx;
  color: #FFFFFF;
  background: #FF6B81;
  border-radius: 12rpx;
  padding: 2rpx 12rpx;
  line-height: 1.5;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 129, 0.3);
}

/* ========== 分区标题 ========== */
.section {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
}

.section-date {
  font-size: 24rpx;
  color: #B0A0A0;
}

/* ========== 检查分组 ========== */
.check-group {
  margin-bottom: 24rpx;
}

.check-group-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.check-group-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.urgent-dot { background: #FF4757; }
.upcoming-dot { background: #FFB8C6; }
.done-dot { background: #2ED573; }
.overdue-dot { background: #FF6B6B; }

.check-group-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #555;
}

/* 检查卡片项 */
.check-card-item {
  display: flex;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
  align-items: flex-start;
}

.check-card-item:active {
  background: #FFFAFB;
  transform: scale(0.98);
  transition: all 0.15s;
}

.required-item {
  background: linear-gradient(135deg, #F8F0FF, #FFF5F7);
  border: 2rpx solid #F0E0F0;
}

.check-upcoming {
  opacity: 0.85;
}

.check-overdue {
  background: #FFF8F8;
  border: 2rpx solid #FFD0D0;
}

.check-done {
  opacity: 0.55;
}

/* 左侧状态 */
.check-left {
  flex-shrink: 0;
  margin-right: 16rpx;
  padding-top: 4rpx;
}

.check-status {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF0F3;
}

.status-urgent {
  background: #FFF0F0;
  animation: urgentPulse 1.5s ease-in-out infinite;
}

@keyframes urgentPulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(255, 71, 87, 0.3); }
  50% { box-shadow: 0 0 0 10rpx rgba(255, 71, 87, 0); }
}

.status-upcoming {
  background: #FFF5F7;
}

.status-overdue {
  background: #FFF0F0;
  animation: urgentPulse 1.5s ease-in-out infinite;
}

.status-done {
  background: #EDFFF5;
}

.status-icon {
  font-size: 20rpx;
  color: #FF6B81;
  font-weight: 700;
}

.status-urgent .status-icon {
  color: #FF4757;
}

.status-done .status-icon {
  color: #2ED573;
}

/* 中间内容 */
.check-center {
  flex: 1;
  min-width: 0;
}

.check-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-bottom: 6rpx;
}

.optional-badge {
  font-size: 18rpx;
  color: #FF9F43;
  background: #FFF5E6;
  border-radius: 4rpx;
  padding: 2rpx 8rpx;
  font-weight: 400;
}

.check-name-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
}

.done-text {
  text-decoration: line-through;
  color: #AAA;
}

.check-date-text {
  font-size: 24rpx;
  color: #FF6B81;
  display: block;
  margin-bottom: 4rpx;
}

.check-done .check-date-text {
  color: #2ED573;
}

.check-desc-text {
  font-size: 23rpx;
  color: #777;
  display: block;
  line-height: 1.5;
  margin-top: 4rpx;
}

.check-deadline-text {
  font-size: 22rpx;
  color: #FF9F43;
  display: inline-block;
  background: #FFF8F0;
  border-radius: 4rpx;
  padding: 2rpx 12rpx;
  margin-bottom: 4rpx;
}

.overdue-deadline {
  color: #FF4757;
  background: #FFF0F0;
}

/* 右侧操作 */
.check-right {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding-top: 4rpx;
}

.check-done-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #FFDCE0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.done-btn-icon {
  font-size: 24rpx;
  color: #FFDCE0;
  font-weight: 700;
}

.check-card-item:active .check-done-btn {
  background: #FF6B81;
  border-color: #FF6B81;
}

.check-card-item:active .done-btn-icon {
  color: #FFFFFF;
}

.check-undo-btn {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: #F5F5F5;
}

.undo-text {
  font-size: 22rpx;
  color: #AAA;
}

/* ========== 底部操作 ========== */
.bottom-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-top: 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
}

.bottom-action {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.bottom-action:active {
  opacity: 0.6;
}

.bottom-action-icon {
  font-size: 36rpx;
}

.bottom-action-text {
  font-size: 24rpx;
  color: #999;
}

.bottom-action-divider {
  width: 2rpx;
  height: 40rpx;
  background: #F0E8E8;
}

/* ========== 意见反馈抽屉 ========== */
.fb-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  animation: fbFadeIn 0.2s ease;
}

@keyframes fbFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.fb-sheet {
  width: 100%;
  background: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  padding: 20rpx 36rpx 54rpx;
  box-sizing: border-box;
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.12);
  animation: fbSlideUp 0.25s ease;
}

@keyframes fbSlideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.fb-handle {
  width: 80rpx;
  height: 8rpx;
  background: #F0E0E0;
  border-radius: 4rpx;
  margin: 0 auto 24rpx;
}

.fb-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  display: block;
  text-align: center;
}

.fb-sub {
  font-size: 22rpx;
  color: #B0A0A0;
  display: block;
  text-align: center;
  margin-top: 10rpx;
  margin-bottom: 28rpx;
}

/* 类型标签 */
.fb-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.fb-tag {
  font-size: 24rpx;
  color: #999;
  background: #F8F4F4;
  border: 2rpx solid transparent;
  border-radius: 32rpx;
  padding: 12rpx 28rpx;
  transition: all 0.2s;
}

.fb-tag-active {
  color: #FF6B81;
  background: linear-gradient(135deg, #FFF0F3, #FFF7F9);
  border-color: #FF6B81;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 129, 0.15);
}

/* 输入框 */
.fb-input-wrap {
  position: relative;
  background: linear-gradient(135deg, #FFF5F7, #FFFAFB);
  border: 2rpx solid #FFDCE0;
  border-radius: 24rpx;
  padding: 24rpx 24rpx 56rpx;
  margin-bottom: 28rpx;
}

.fb-textarea {
  width: 100%;
  height: 200rpx;
  font-size: 28rpx;
  color: #444;
  line-height: 1.6;
}

.fb-placeholder {
  color: #D0C0C0;
}

.fb-count {
  position: absolute;
  right: 24rpx;
  bottom: 18rpx;
  font-size: 20rpx;
  color: #C0B0B0;
}

.fb-count-warn {
  color: #FF6B81;
}

/* 提交按钮 */
.fb-submit-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: linear-gradient(135deg, #FF6B81, #FF8A9E);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 46rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 129, 0.3);
}

.fb-submit-btn[disabled] {
  background: #F0E0E0;
  color: #CCC;
  box-shadow: none;
}

.fb-cancel {
  text-align: center;
  font-size: 26rpx;
  color: #B0A0A0;
  padding: 26rpx 0 8rpx;
}
