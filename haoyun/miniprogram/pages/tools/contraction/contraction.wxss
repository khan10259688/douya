.container {
  padding: 24rpx 24rpx 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 30rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(255, 107, 129, 0.05);
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2C2C2C;
}

.card-sub {
  font-size: 22rpx;
  color: #FF6B81;
  display: block;
  margin-top: 4rpx;
}

.card-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title-wrap {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.card-title-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #FFF0F3;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-title-emoji {
  font-size: 30rpx;
}

.today-badge {
  font-size: 22rpx;
  color: #FF6B81;
  background: #FFF0F3;
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
  font-weight: 600;
}

/* 说明卡 */
.tip-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.tip-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #FFE5EC 0%, #FFF0F3 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.tip-emoji {
  font-size: 40rpx;
}

.tip-title-wrap {
  display: flex;
  flex-direction: column;
}

.tip-body {
  background: #FFF8FA;
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
}

.rule-grid {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 8rpx 0 20rpx;
}

.rule-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.rule-num {
  font-size: 56rpx;
  font-weight: 800;
  color: #FF6B81;
  line-height: 1;
}

.rule-unit {
  font-size: 20rpx;
  color: #B0A8A8;
}

.rule-label {
  font-size: 22rpx;
  color: #888;
  margin-top: 4rpx;
  font-weight: 500;
}

.rule-divider {
  width: 1rpx;
  height: 60rpx;
  background: #F0E0E4;
}

.tip-text {
  font-size: 24rpx;
  color: #6B6B6B;
  line-height: 1.7;
  display: block;
  text-align: center;
  margin-top: 4rpx;
}

/* 计时器 */
.timer-card {
  position: relative;
  background: linear-gradient(135deg, #FF6B81 0%, #FF8FA3 100%);
  border-radius: 36rpx;
  padding: 48rpx 32rpx 56rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(255, 107, 129, 0.25);
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
  transition: all 0.4s ease;
}

.timer-running {
  background: linear-gradient(135deg, #FF4757 0%, #FF6B81 100%);
  box-shadow: 0 12rpx 48rpx rgba(255, 71, 87, 0.35);
}

.timer-glow {
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.25) 0%, transparent 70%);
  pointer-events: none;
}

.timer-content {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  z-index: 1;
}

.timer-state-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.timer-state-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.7);
}

.dot-pulse {
  background: #FFFFFF;
  animation: dotPulse 1.4s ease-in-out infinite;
}

@keyframes dotPulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(1.3); }
}

.timer-state {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

.big-time {
  font-size: 140rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1;
  margin-top: 16rpx;
  font-variant-numeric: tabular-nums;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.timer-btn {
  width: 100%;
  height: 104rpx;
  background: rgba(255, 255, 255, 0.98);
  border-radius: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 36rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.08);
  transition: all 0.2s ease;
}

.timer-btn:active {
  transform: scale(0.97);
}

.timer-btn-stop {
  background: #FFFFFF;
}

.timer-btn-emoji {
  font-size: 28rpx;
  color: #FF6B81;
}

.timer-btn-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #FF4E6E;
}

/* 预警 */
.alert-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: linear-gradient(135deg, #FFEEEE 0%, #FFF4F4 100%);
  border: 2rpx solid #FFD0D0;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.alert-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.alert-emoji {
  font-size: 32rpx;
}

.alert-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.alert-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #FF4757;
}

.alert-text {
  font-size: 24rpx;
  color: #FF6B81;
  line-height: 1.5;
}

/* 宫缩列表 */
.ct-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F8F2F4;
}

.ct-item:last-child {
  border-bottom: none;
}

.ct-index {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #FFF0F3 0%, #FFE5EC 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #FF6B81;
  flex-shrink: 0;
}

.ct-main {
  flex: 1;
}

.ct-start {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C2C2C;
  display: block;
  margin-bottom: 10rpx;
}

.ct-meta-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.ct-meta-item {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.ct-meta-label {
  font-size: 20rpx;
  color: #B0A8A8;
}

.ct-meta-value {
  font-size: 24rpx;
  color: #555;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.ct-meta-sep {
  width: 1rpx;
  height: 32rpx;
  background: #F0E0E4;
}

.clear-btn {
  margin-top: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: #B0A8A8;
  padding: 16rpx 0;
  border-top: 1rpx solid #F8F2F4;
}

.clear-btn:active {
  color: #FF4757;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.empty-emoji-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFF0F3 0%, #FFE5EC 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-emoji {
  font-size: 72rpx;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #888;
}

.empty-sub {
  font-size: 24rpx;
  color: #B8B0B0;
  text-align: center;
  margin-top: 12rpx;
  line-height: 1.6;
}
