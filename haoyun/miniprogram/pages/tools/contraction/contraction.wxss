.container {
  padding: 24rpx 24rpx 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 30rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.card-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.tip-card .tip-line {
  font-size: 24rpx;
  color: #777;
  line-height: 1.8;
  display: block;
  margin-top: 12rpx;
}

.clear-btn {
  font-size: 24rpx;
  color: #B0A0A0;
  border: 2rpx solid #F0E8E8;
  border-radius: 24rpx;
  padding: 6rpx 20rpx;
}

/* 计时器 */
.timer-card {
  background: linear-gradient(135deg, #FF6B81 0%, #FF8A9E 100%);
  border-radius: 32rpx;
  padding: 40rpx 32rpx 48rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(255, 107, 129, 0.25);
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: background 0.3s;
}

.timer-running {
  background: linear-gradient(135deg, #FF4757 0%, #FF6B81 100%);
}

.timer-state {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.big-time {
  font-size: 120rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1.1;
  margin-top: 12rpx;
  font-variant-numeric: tabular-nums;
}

.timer-btn {
  width: 100%;
  height: 96rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 32rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
}

.timer-btn:active {
  transform: scale(0.97);
}

.timer-btn-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF6B81;
}

/* 预警 */
.alert-card {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: linear-gradient(135deg, #FFEEEE, #FFF4F4);
  border: 2rpx solid #FFD0D0;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.alert-emoji {
  font-size: 32rpx;
}

.alert-text {
  flex: 1;
  font-size: 26rpx;
  font-weight: 600;
  color: #FF4757;
}

/* 宫缩列表 */
.ct-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F8F0F0;
}

.ct-item:last-child {
  border-bottom: none;
}

.ct-index {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: #FFF0F3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #FF6B81;
  flex-shrink: 0;
}

.ct-main {
  flex: 1;
}

.ct-start {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.ct-meta {
  font-size: 22rpx;
  color: #B0A0A0;
  display: block;
  margin-top: 6rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.empty-emoji {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #999;
}

.empty-sub {
  font-size: 24rpx;
  color: #C0B0B0;
  text-align: center;
  margin-top: 12rpx;
  line-height: 1.6;
}
