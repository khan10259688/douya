.container {
  padding: 24rpx 24rpx 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ========== 工具卡片 ========== */
.tool-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.tool-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.tool-card:active {
  background: #FFFAFB;
  transform: scale(0.99);
}

.tool-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #FFF0F3, #FFF7F9);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.tool-emoji {
  font-size: 44rpx;
}

.tool-info {
  flex: 1;
  min-width: 0;
}

.tool-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  display: block;
}

.tool-desc {
  font-size: 24rpx;
  color: #B0A0A0;
  display: block;
  margin-top: 6rpx;
}

.tool-arrow {
  font-size: 40rpx;
  color: #E8D5D5;
  font-weight: 700;
  flex-shrink: 0;
}

/* ========== 快捷统计 ========== */
.quick-row {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.quick-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #FF6B81;
}

.stat-name {
  font-size: 22rpx;
  color: #B0A0A0;
  margin-top: 6rpx;
}

.quick-divider {
  width: 2rpx;
  height: 56rpx;
  background: #F0E8E8;
}

/* ========== 底部说明 ========== */
.footer-tip {
  text-align: center;
  font-size: 22rpx;
  color: #C8B8B8;
  padding: 24rpx 0;
}
