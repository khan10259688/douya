.container {
  padding: 24rpx 24rpx 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 30rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.card-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.card-sub {
  font-size: 22rpx;
  color: #FF6B81;
}

/* 说明卡 */
.tip-lines {
  margin-top: 16rpx;
}

.tip-line {
  font-size: 24rpx;
  color: #777;
  line-height: 1.9;
  display: block;
}

/* 计数器 */
.counter-card {
  background: linear-gradient(135deg, #FF6B81 0%, #FF8A9E 50%, #FF9AAE 100%);
  border-radius: 32rpx;
  padding: 40rpx 32rpx 48rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 129, 0.2);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.counter-state {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.big-num {
  font-size: 140rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1.1;
  margin-top: 12rpx;
}

.counter-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 4rpx;
}

.kick-btn {
  width: 100%;
  height: 96rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 32rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
}

.kick-btn:active {
  transform: scale(0.97);
}

.kick-btn-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF6B81;
}

.finish-btn {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 36rpx;
  padding: 12rpx 40rpx;
}

.reached-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
}

/* 记录列表 */
.rec-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F6F0F0;
}

.rec-item:last-child {
  border-bottom: none;
}

.rec-main {
  flex: 1;
}

.rec-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.rec-count {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}

.rec-badge {
  font-size: 18rpx;
  padding: 2rpx 14rpx;
  border-radius: 12rpx;
}

.rec-badge.great {
  color: #2ED573;
  background: #E8FAF0;
}

.rec-badge.ok {
  color: #FF9F43;
  background: #FFF6E8;
}

.rec-badge.warn {
  color: #FF4757;
  background: #FFEEEE;
}

.rec-meta {
  font-size: 22rpx;
  color: #B0A0A0;
  display: block;
  margin-top: 6rpx;
}

.rec-del {
  font-size: 22rpx;
  color: #B0A0A0;
  background: #F8F4F4;
  border-radius: 20rpx;
  padding: 8rpx 18rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.empty-emoji {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #999;
}

.empty-sub {
  font-size: 24rpx;
  color: #C0B0B0;
  text-align: center;
  margin-top: 12rpx;
  line-height: 1.6;
}
