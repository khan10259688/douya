<view class="container">
  <!-- 数胎动说明 -->
  <view class="card tip-card">
    <view class="tip-header">
      <view class="tip-icon">
        <text class="tip-emoji">👶</text>
      </view>
      <view class="tip-title-wrap">
        <text class="card-title">数胎动小课堂</text>
        <text class="card-sub">每日早中晚各 1 小时</text>
      </view>
    </view>
    <view class="tip-lines">
      <view class="tip-line">
        <text class="tip-dot"></text>
        <text class="tip-text">孕 28 周起，建议每天早中晚各固定 1 小时</text>
      </view>
      <view class="tip-line">
        <text class="tip-dot"></text>
        <text class="tip-text">胎动连续动一阵算 1 次，间隔 2 分钟以上分开算</text>
      </view>
      <view class="tip-line">
        <text class="tip-dot tip-dot-warn"></text>
        <text class="tip-text">1 小时不足 3 次或较平时明显减少，及时咨询医生</text>
      </view>
      <view class="tip-line">
        <text class="tip-dot tip-dot-ok"></text>
        <text class="tip-text">也可用"数到 10 次"法：数满 10 次即达标</text>
      </view>
    </view>
  </view>

  <!-- 计数器 -->
  <view class="counter-card {{counting ? 'counter-active' : ''}}">
    <view class="counter-glow"></view>
    <view class="counter-content">
      <view class="counter-state-row">
        <view class="counter-state-dot {{counting ? 'dot-pulse' : ''}}"></view>
        <text class="counter-state">{{counting ? '计数中' : '准备就绪'}}</text>
      </view>
      <view class="big-num {{counting ? 'num-active' : ''}}">{{count}}</view>
      <text class="counter-sub">次 · {{elapsedText}}</text>
      <view class="kick-btn {{counting ? 'kick-btn-active' : ''}}" bindtap="onTapMain">
        <text class="kick-btn-emoji">{{counting ? '👆' : '胎动'}}</text>
        <text class="kick-btn-text">{{counting ? '动一下点我' : '开始计数'}}</text>
      </view>
      <view class="finish-btn" wx:if="{{counting}}" bindtap="finishSession">结束并保存</view>
      <view class="reached-tip" wx:if="{{counting && count >= 10}}">
        <text class="reached-emoji">🎉</text>
        <text>已达标，宝宝状态良好</text>
      </view>
    </view>
  </view>

  <!-- 历史记录 -->
  <view class="card" wx:if="{{records.length > 0}}">
    <view class="card-row">
      <view class="card-title-wrap">
        <view class="card-title-icon">
          <text class="card-title-emoji">📊</text>
        </view>
        <text class="card-title">历史记录</text>
      </view>
      <view class="today-badge">今日 {{todayTotal}} 次</view>
    </view>
    <view class="rec-item" wx:for="{{records}}" wx:key="id">
      <view class="rec-index">{{index + 1}}</view>
      <view class="rec-main">
        <view class="rec-head">
          <text class="rec-count">{{item.count}} 次</text>
          <text class="rec-badge {{item.statusClass}}">{{item.statusText}}</text>
        </view>
        <text class="rec-meta">{{item.date}} {{item.time}} · 用时 {{item.durationText}}</text>
      </view>
      <view class="rec-del" data-id="{{item.id}}" bindtap="deleteRecord">
        <text class="rec-del-icon">🗑</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{records.length === 0}}">
    <view class="empty-emoji-wrap">
      <text class="empty-emoji">👶</text>
    </view>
    <text class="empty-text">还没有胎动记录</text>
    <text class="empty-sub">孕 28 周起开始数胎动，监测宝宝安好</text>
  </view>
</view>
