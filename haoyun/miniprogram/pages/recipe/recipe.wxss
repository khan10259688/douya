.container {
  padding: 24rpx 24rpx 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ========== 未设置状态 ========== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-emoji {
  font-size: 88rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #999;
}

.empty-sub {
  font-size: 24rpx;
  color: #C0B0B0;
  text-align: center;
  margin-top: 14rpx;
  line-height: 1.7;
}

.empty-btn {
  margin-top: 48rpx;
  width: 320rpx;
  height: 84rpx;
  line-height: 84rpx;
  background: linear-gradient(135deg, #FF6B81, #FF8A9E);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 42rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 129, 0.3);
}

/* ========== 顶部卡片 ========== */
.hero {
  background: linear-gradient(135deg, #FF6B81 0%, #FF8A9E 40%, #FF9AAE 100%);
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 129, 0.2);
  margin-bottom: 24rpx;
}

.diet-sheet {
  width: 100%;
  background: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  padding: 20rpx 36rpx 54rpx;
  box-sizing: border-box;
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.12);
}

.hero-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.hero-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.hero-tag {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 24rpx;
  padding: 6rpx 20rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.hero-tag-divider {
  margin: 0 8rpx;
  opacity: 0.7;
}

.hero-diet-btn {
  font-size: 24rpx;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 24rpx;
  padding: 6rpx 22rpx;
}

.hero-sub-row {
  margin-bottom: 20rpx;
}

/* 忌口抽屉 */
.diet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.diet-sheet {
  width: 100%;
  background: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  padding: 20rpx 36rpx 54rpx;
  box-sizing: border-box;
}

.diet-handle {
  width: 80rpx;
  height: 8rpx;
  background: #F0E0E0;
  border-radius: 4rpx;
  margin: 0 auto 24rpx;
}

.diet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  display: block;
  text-align: center;
}

.diet-sub {
  font-size: 22rpx;
  color: #B0A0A0;
  display: block;
  text-align: center;
  margin-top: 8rpx;
  margin-bottom: 28rpx;
}

.diet-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.diet-opt {
  font-size: 26rpx;
  color: #999;
  background: #F8F4F4;
  border: 2rpx solid transparent;
  border-radius: 32rpx;
  padding: 14rpx 28rpx;
}

.diet-on {
  color: #FF6B81;
  background: linear-gradient(135deg, #FFF0F3, #FFF7F9);
  border-color: #FF6B81;
  font-weight: 600;
}

.diet-done {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #FF6B81, #FF8A9E);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 129, 0.3);
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.chip {
  font-size: 22rpx;
  color: #FF6B81;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 6rpx 20rpx;
  font-weight: 600;
}

.hero-tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
  line-height: 1.6;
}

/* ========== 三餐卡片 ========== */
.meal-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 30rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.accent-breakfast {
  border-left: 10rpx solid #FF9F43;
}

.accent-lunch {
  border-left: 10rpx solid #2ED573;
}

.accent-dinner {
  border-left: 10rpx solid #9B59B6;
}

.meal-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.meal-emoji {
  font-size: 36rpx;
}

.meal-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.meal-change {
  font-size: 22rpx;
  color: #FF6B81;
  background: #FFF0F3;
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
}

.meal-change:active {
  background: #FF6B81;
  color: #FFFFFF;
}

.dish-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.dish {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #FFFAFB;
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
}

.accent-breakfast .dish {
  background: #FFFBF4;
}

.accent-lunch .dish {
  background: #F5FFFA;
}

.accent-dinner .dish {
  background: #F9F6FC;
}

.dish-dot {
  font-size: 14rpx;
}

.accent-breakfast .dish-dot {
  color: #FF9F43;
}

.accent-lunch .dish-dot {
  color: #2ED573;
}

.accent-dinner .dish-dot {
  color: #9B59B6;
}

.dish-name {
  font-size: 28rpx;
  color: #444;
  font-weight: 500;
}

/* ========== 营养素说明 ========== */
.card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 30rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  display: block;
  margin-bottom: 24rpx;
}

.nutrient-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.nutrient-item {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.nutrient-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #FF6B81;
  background: #FFF0F3;
  border-radius: 10rpx;
  padding: 6rpx 16rpx;
  flex-shrink: 0;
}

.nutrient-desc {
  flex: 1;
  font-size: 24rpx;
  color: #777;
  line-height: 1.6;
}

/* ========== 底部说明 ========== */
.note {
  font-size: 22rpx;
  color: #C8B8B8;
  text-align: center;
  line-height: 1.6;
  padding: 8rpx 20rpx;
}
