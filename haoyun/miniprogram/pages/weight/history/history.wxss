.container {
  padding: 24rpx 24rpx 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ========== 筛选 tabs ========== */
.filter-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.filter-tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #999;
  background: #FFFFFF;
  border: 2rpx solid #F0E8E8;
  border-radius: 24rpx;
  padding: 14rpx 0;
  transition: all 0.2s;
}

.tab-on {
  color: #FFFFFF;
  background: linear-gradient(135deg, #FF6B81, #FF8A9E);
  border-color: #FF6B81;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 129, 0.2);
}

/* ========== 月份分组 ========== */
.month-group {
  margin-bottom: 24rpx;
}

.month-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 0 8rpx;
  margin-bottom: 12rpx;
}

.month-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #888;
}

.month-count {
  font-size: 22rpx;
  color: #C0B0B0;
}

.month-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

/* ========== 记录条目 ========== */
.rec-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 4rpx;
  border-bottom: 2rpx solid #F8F0F0;
}

.rec-item:last-child {
  border-bottom: none;
}

.rec-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.dot-morning { background: #FF9F43; }
.dot-daytime { background: #B0A8C8; }

.rec-main {
  flex: 1;
  min-width: 0;
}

.rec-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.rec-weight {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.rec-unit {
  font-size: 20rpx;
  color: #B0A0A0;
  margin-left: 2rpx;
}

.rec-tag {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.tag-morning { color: #FF9F43; background: #FFF3E2; }
.tag-daytime { color: #8E8E9E; background: #EFEFF4; }

.rec-meta {
  font-size: 21rpx;
  color: #B0A0A0;
  display: block;
  margin-top: 4rpx;
}

.rec-del {
  font-size: 21rpx;
  color: #C0B0B0;
  background: #F8F4F4;
  border-radius: 20rpx;
  padding: 8rpx 16rpx;
  flex-shrink: 0;
}

/* ========== 底部 ========== */
.footer {
  text-align: center;
  font-size: 22rpx;
  color: #C0B0B0;
  padding: 20rpx 0;
}

.load-more {
  color: #FF6B81;
}

.end-text {
  color: #D0C0C0;
}

/* ========== 空状态 ========== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-emoji {
  font-size: 88rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #999;
}

.empty-emoji {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #999;
}

.empty-sub {
  font-size: 24rpx;
  color: #C0B0B0;
  margin-top: 12rpx;
}
