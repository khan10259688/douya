.container {
  padding: 24rpx 24rpx 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ========== 顶部主卡 ========== */
.hero-card {
  background: linear-gradient(135deg, #FF6B81 0%, #FF8A9E 50%, #FF9AAE 100%);
  border-radius: 32rpx;
  padding: 36rpx 32rpx 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 129, 0.2);
  margin-bottom: 24rpx;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.hero-left {
  flex: 1;
}

.hero-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  display: block;
}

.hero-value-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-top: 6rpx;
}

.hero-value {
  font-size: 76rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.hero-unit {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
}

.hero-diff {
  font-size: 24rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.25);
  color: #FFFFFF;
}

.diff-down {
  background: rgba(255, 255, 255, 0.3);
}

.diff-flat {
  background: rgba(255, 255, 255, 0.22);
}

.hero-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
  display: block;
  margin-top: 10rpx;
}

.hero-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 20rpx;
  padding: 14rpx 20rpx;
}

.hero-badge-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.hero-badge-name {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.82);
  margin-top: 2rpx;
}

.hero-divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.22);
  margin: 26rpx 0 22rpx;
}

.hero-row {
  display: flex;
  align-items: center;
}

.hero-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-cell:active {
  opacity: 0.8;
}

.hero-cell-sep {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.2);
}

.cell-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.78);
}

.cell-value-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 4rpx;
}

.cell-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.cell-empty {
  color: rgba(255, 255, 255, 0.7);
  font-weight: 500;
}

.cell-gain {
  font-size: 22rpx;
  font-weight: 700;
}

.cell-gain.gain-up { color: #FFE7EC; }
.cell-gain.gain-down { color: #E6FFEF; }

/* 增重参考带 */
.gain-band {
  margin-top: 22rpx;
}

.gain-bar {
  position: relative;
  width: 100%;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 6rpx;
  overflow: visible;
}

.gain-zone {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 28.1%;
  background: rgba(255, 255, 255, 0.55);
  border-radius: 6rpx;
}

.gain-marker {
  position: absolute;
  top: -6rpx;
  width: 4rpx;
  height: 24rpx;
  background: #FFFFFF;
  border-radius: 2rpx;
  transform: translateX(-50%);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.2);
}

.gain-legend {
  font-size: 19rpx;
  color: rgba(255, 255, 255, 0.8);
}

.gain-info-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 10rpx;
}

.gain-current {
  font-size: 22rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.gain-hint {
  display: block;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 8rpx;
  line-height: 1.5;
}

.gain-tip {
  margin-top: 18rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.18);
  border-radius: 20rpx;
  padding: 12rpx 0;
}

/* ========== 记录入口大按钮 ========== */
.record-btn {
  width: 100%;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  background: linear-gradient(135deg, #FF6B81, #FF8A9E);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(255, 107, 129, 0.2);
  margin-bottom: 24rpx;
}

.record-btn:active {
  transform: scale(0.98);
  opacity: 0.92;
}

.record-btn-icon {
  width: 44rpx;
  height: 44rpx;
}

.record-btn-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

/* ========== 通用卡片 ========== */
.card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 30rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.card-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

/* 趋势图 */
.chart-card .card-title-row {
  margin-bottom: 8rpx;
}

.chart-wrap {
  width: 100%;
  height: 380rpx;
}

.trend-canvas {
  width: 100%;
  height: 380rpx;
}

.chart-hint {
  font-size: 20rpx;
  color: #C0B0B0;
  text-align: center;
  margin-top: 6rpx;
}

.download-btn {
  font-size: 23rpx;
  color: #FF6B81;
  border: 2rpx solid #FFDCE0;
  border-radius: 28rpx;
  padding: 6rpx 20rpx;
  background: linear-gradient(135deg, #FFF5F7, #FFFAFB);
}

.download-btn:active {
  background: #FF6B81;
  color: #FFFFFF;
  border-color: #FF6B81;
}

/* 日间波动卡 */
.fluct-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.fluct-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #F3EFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.fluct-info {
  flex: 1;
  min-width: 0;
}

.fluct-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #555;
  display: block;
}

.fluct-desc {
  font-size: 19rpx;
  color: #C0B0B0;
  display: block;
  margin-top: 4rpx;
}

.fluct-value {
  font-size: 32rpx;
  font-weight: 800;
  color: #9B59B6;
  flex-shrink: 0;
}

/* 记录列表 */
.clear-btn {
  font-size: 23rpx;
  color: #B0A0A0;
  border: 2rpx solid #F0E8E8;
  border-radius: 24rpx;
  padding: 4rpx 18rpx;
}

.all-link {
  font-size: 23rpx;
  color: #FF6B81;
  font-weight: 500;
}

.more-link {
  text-align: center;
  font-size: 24rpx;
  color: #FF6B81;
  padding: 18rpx 0 6rpx;
  border-top: 1rpx solid #F6F0F0;
  margin-top: 8rpx;
}

.record-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 4rpx;
  border-bottom: 2rpx solid #F8F0F0;
}

.record-item:last-child {
  border-bottom: none;
}

.record-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.record-dot.tag-morning { background: #FF9F43; }
.record-dot.tag-daytime { background: #B0A8C8; }

.record-main {
  flex: 1;
  min-width: 0;
}

.record-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.record-weight {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.record-unit {
  font-size: 20rpx;
  color: #B0A0A0;
  margin-left: 2rpx;
}

.period-tag {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.tag-morning { color: #FF9F43; background: #FFF3E2; }
.tag-daytime { color: #8E8E9E; background: #EFEFF4; }

.record-meta {
  font-size: 21rpx;
  color: #B0A0A0;
  display: block;
  margin-top: 4rpx;
}

.delete-btn {
  font-size: 21rpx;
  color: #C0B0B0;
  background: #F8F4F4;
  border-radius: 20rpx;
  padding: 8rpx 16rpx;
  flex-shrink: 0;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.empty-emoji {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #999;
}

.empty-sub {
  font-size: 24rpx;
  color: #C0B0B0;
  text-align: center;
  margin-top: 12rpx;
  line-height: 1.6;
}

/* ========== 记录日期选择 ========== */
.record-date-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: linear-gradient(135deg, #FFF5F7, #FFFAFB);
  border: 2rpx solid #FFDCE0;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  margin: 16rpx 0 20rpx;
}

.record-date-row:active {
  border-color: #FF6B81;
}

.record-date-icon {
  width: 32rpx;
  height: 32rpx;
}

.record-date-text {
  flex: 1;
  font-size: 26rpx;
  color: #FF6B81;
  font-weight: 500;
}

.record-date-arrow {
  font-size: 32rpx;
  color: #FFDCE0;
  font-weight: 700;
  line-height: 1;
}

/* ========== 底部抽屉 ========== */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  padding: 20rpx 36rpx 54rpx;
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.12);
  box-sizing: border-box;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}

.sheet-with-kb {
  max-height: none;
}

.sheet-scroll {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.sheet-footer {
  flex-shrink: 0;
  padding-top: 12rpx;
}

.sheet-handle {
  width: 80rpx;
  height: 8rpx;
  background: #F0E0E0;
  border-radius: 4rpx;
  margin: 0 auto 24rpx;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  display: block;
  text-align: center;
  margin-bottom: 8rpx;
}

.sheet-sub {
  font-size: 22rpx;
  color: #B0A0A0;
  display: block;
  text-align: center;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

/* 类型选项 */
.type-option {
  position: relative;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #FFF9FA;
  border: 2rpx solid #FFE0E4;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  transition: all 0.2s;
}

.type-active {
  background: linear-gradient(135deg, #FFF0F3, #FFF7F9);
  border-color: #FF6B81;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 129, 0.15);
}

.type-badge {
  position: absolute;
  top: -14rpx;
  left: 24rpx;
  font-size: 18rpx;
  color: #FFFFFF;
  border-radius: 8rpx;
  padding: 3rpx 14rpx;
  line-height: 1.4;
}

.badge-recommend { background: linear-gradient(135deg, #FF9F43, #FFB56B); }
.badge-supplement { background: linear-gradient(135deg, #B0A6B8, #C4BCCB); }

.type-emoji {
  font-size: 44rpx;
  margin-left: 8rpx;
}

.type-text {
  flex: 1;
}

.type-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  display: block;
}

.type-desc {
  font-size: 22rpx;
  color: #B0A0A0;
  display: block;
  margin-top: 6rpx;
}

.type-radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 3rpx solid #E8D5D5;
  background: #FFFFFF;
  flex-shrink: 0;
  box-sizing: border-box;
}

.radio-on {
  border-color: #FF6B81;
  border-width: 10rpx;
}

/* 输入区 */
.input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.weight-input {
  flex: 1;
  height: 88rpx;
  background: linear-gradient(135deg, #FFF5F7, #FFFAFB);
  border: 2rpx solid #FFDCE0;
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 36rpx;
  color: #FF6B81;
  font-weight: 700;
  box-sizing: border-box;
}

.weight-input::placeholder {
  color: #D0C0C0;
  font-weight: 400;
}

.input-unit {
  font-size: 28rpx;
  color: #999;
}

.sheet-save-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: linear-gradient(135deg, #FF6B81, #FF8A9E);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 46rpx;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 129, 0.3);
}

/* ========== 离屏导出画布 ========== */
.export-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 350px;
  height: 230px;
}

/* ========== 下载弹窗 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal {
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 36rpx 32rpx;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.15);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  display: block;
  text-align: center;
}

.modal-sub {
  font-size: 24rpx;
  color: #B0A0A0;
  display: block;
  text-align: center;
  margin-top: 10rpx;
  margin-bottom: 28rpx;
}

.range-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.range-option {
  flex: 1;
  min-width: 28%;
  text-align: center;
  font-size: 26rpx;
  color: #999;
  background: #FFF5F7;
  border: 2rpx solid #FFE0E4;
  border-radius: 16rpx;
  padding: 18rpx 0;
}

.range-active {
  color: #FFFFFF;
  background: linear-gradient(135deg, #FF6B81, #FF8A9E);
  border-color: #FF6B81;
  font-weight: 600;
}

.custom-range {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.custom-picker {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #C0B0B0;
  background: #FFF9FA;
  border: 2rpx solid #FFE0E4;
  border-radius: 16rpx;
  padding: 18rpx 0;
}

.custom-picked {
  color: #FF6B81;
  font-weight: 500;
  border-color: #FF6B81;
}

.custom-sep {
  font-size: 24rpx;
  color: #B0A0A0;
}

.modal-download-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #FF6B81, #FF8A9E);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  text-align: center;
  margin-top: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 129, 0.3);
}

.modal-download-btn[disabled] {
  background: #F0E0E0;
  color: #CCC;
  box-shadow: none;
}

.modal-cancel {
  text-align: center;
  font-size: 26rpx;
  color: #B0A0A0;
  padding: 24rpx 0 8rpx;
}

/* ========== 增重参考带（旧 register 卡用，保留兼容） ========== */
.gain-up { color: #FF6B81; }
.gain-down { color: #2ED573; }
