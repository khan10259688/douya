.container {
  padding: 24rpx 24rpx 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ========== 统计卡片 ========== */
.stats-card {
  background: linear-gradient(135deg, #FF6B81 0%, #FF8A9E 40%, #FF9AAE 100%);
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 129, 0.2);
  margin-bottom: 24rpx;
}

.stats-main {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.stats-icon {
  font-size: 64rpx;
  margin-right: 24rpx;
}

.stats-info {
  flex: 1;
}

.stats-label {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  display: block;
  margin-bottom: 6rpx;
}

.stats-value-row {
  display: flex;
  align-items: baseline;
}

.stats-value {
  font-size: 64rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1;
}

.stats-unit {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  margin-left: 6rpx;
}

.stats-diff {
  font-size: 24rpx;
  font-weight: 700;
  margin-left: 16rpx;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
}

.diff-up {
  background: rgba(255,255,255,0.25);
  color: #FFFFFF;
}

.diff-down {
  background: rgba(255,255,255,0.25);
  color: #FFFFFF;
}

.diff-flat {
  background: rgba(255,255,255,0.2);
  color: #FFFFFF;
}

.stats-sub {
  font-size: 22rpx;
  color: rgba(255,255,255,0.75);
  display: block;
  margin-top: 8rpx;
}

.stats-grid {
  display: flex;
  border-top: 2rpx solid rgba(255,255,255,0.2);
  padding-top: 24rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.stat-name {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 4rpx;
}

/* ========== 通用卡片 ========== */
.card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.card-subtitle {
  font-size: 22rpx;
  color: #B0A0A0;
  display: block;
  margin-top: 6rpx;
  margin-bottom: 24rpx;
}

/* ========== 记录日期选择 ========== */
.record-date-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: linear-gradient(135deg, #FFF5F7, #FFFAFB);
  border: 2rpx solid #FFDCE0;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  margin: 16rpx 0 24rpx;
}

.record-date-row:active {
  border-color: #FF6B81;
}

.record-date-icon {
  width: 32rpx;
  height: 32rpx;
}

.record-date-text {
  flex: 1;
  font-size: 26rpx;
  color: #FF6B81;
  font-weight: 500;
}

.record-date-arrow {
  font-size: 32rpx;
  color: #FFDCE0;
  font-weight: 700;
  line-height: 1;
}

.card-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

/* ========== 建档体重卡片 ========== */
.register-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.register-card:active {
  background: #FFFAFB;
}

.register-left {
  flex-shrink: 0;
}

.register-emoji {
  font-size: 44rpx;
}

.register-info {
  flex: 1;
  min-width: 0;
}

.register-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  flex-wrap: wrap;
}

.register-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}

.register-date {
  font-size: 22rpx;
  color: #B0A0A0;
}

.register-gain {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

.register-gain-label {
  font-size: 24rpx;
  color: #999;
}

.register-gain-value {
  font-size: 30rpx;
  font-weight: 800;
}

.gain-up {
  color: #FF6B81;
}

.gain-down {
  color: #2ED573;
}

.register-hint {
  font-size: 22rpx;
  color: #C0B0B0;
  display: block;
  margin-top: 6rpx;
}

.register-arrow {
  font-size: 36rpx;
  color: #E8D5D5;
  font-weight: 700;
  flex-shrink: 0;
}

/* 增重参考带 */
.gain-band {
  margin-top: 16rpx;
}

.gain-bar {
  position: relative;
  width: 100%;
  height: 14rpx;
  background: #F5EDED;
  border-radius: 7rpx;
  overflow: visible;
}

.gain-zone {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 28.1%;
  background: rgba(46, 213, 115, 0.28);
  border-radius: 7rpx;
}

.gain-marker {
  position: absolute;
  top: -6rpx;
  width: 4rpx;
  height: 26rpx;
  background: #FF6B81;
  border-radius: 2rpx;
  transform: translateX(-50%);
  box-shadow: 0 2rpx 6rpx rgba(255, 107, 129, 0.4);
}

.gain-legend {
  font-size: 20rpx;
  color: #C0B0B0;
  display: block;
  margin-top: 10rpx;
}

.sheet-sub {
  font-size: 22rpx;
  color: #B0A0A0;
  display: block;
  text-align: center;
  margin-top: -16rpx;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

/* ========== 记录入口大按钮 ========== */
.record-btn {
  width: 100%;
  height: 108rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  background: linear-gradient(135deg, #FF6B81, #FF8A9E);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(255, 107, 129, 0.35);
  margin-bottom: 24rpx;
}

.record-btn:active {
  transform: scale(0.98);
  opacity: 0.92;
}

.record-btn-icon {
  font-size: 36rpx;
}

.record-btn-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

/* ========== 底部记录抽屉 ========== */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  padding: 20rpx 36rpx 60rpx;
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.12);
  box-sizing: border-box;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}

.sheet-with-kb {
  max-height: none;
}

.sheet-scroll {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.sheet-footer {
  flex-shrink: 0;
  padding-top: 12rpx;
}

.sheet-handle {
  width: 80rpx;
  height: 8rpx;
  background: #F0E0E0;
  border-radius: 4rpx;
  margin: 0 auto 24rpx;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  display: block;
  text-align: center;
  margin-bottom: 28rpx;
}

/* 类型选项 */
.type-option {
  position: relative;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #FFF9FA;
  border: 2rpx solid #FFE0E4;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  transition: all 0.2s;
}

.type-active {
  background: linear-gradient(135deg, #FFF0F3, #FFF7F9);
  border-color: #FF6B81;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 129, 0.15);
}

.type-badge {
  position: absolute;
  top: -14rpx;
  left: 24rpx;
  font-size: 18rpx;
  color: #FFFFFF;
  border-radius: 8rpx;
  padding: 3rpx 14rpx;
  line-height: 1.4;
}

.badge-recommend {
  background: linear-gradient(135deg, #FF9F43, #FFB56B);
}

.badge-supplement {
  background: linear-gradient(135deg, #B0A6B8, #C4BCCB);
}

.type-emoji {
  font-size: 44rpx;
  margin-left: 8rpx;
}

.type-text {
  flex: 1;
}

.type-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  display: block;
}

.type-desc {
  font-size: 22rpx;
  color: #B0A0A0;
  display: block;
  margin-top: 6rpx;
}

.type-radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 3rpx solid #E8D5D5;
  background: #FFFFFF;
  flex-shrink: 0;
  box-sizing: border-box;
}

.radio-on {
  border-color: #FF6B81;
  border-width: 10rpx;
}

.sheet-save-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: linear-gradient(135deg, #FF6B81, #FF8A9E);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 46rpx;
  text-align: center;
  margin-top: 8rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 129, 0.3);
}

/* ========== 输入区域 ========== */
.input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.weight-input {
  flex: 1;
  height: 88rpx;
  background: linear-gradient(135deg, #FFF5F7, #FFFAFB);
  border: 2rpx solid #FFDCE0;
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 36rpx;
  color: #FF6B81;
  font-weight: 700;
  box-sizing: border-box;
}

.weight-input::placeholder {
  color: #D0C0C0;
  font-weight: 400;
}

.input-unit {
  font-size: 28rpx;
  color: #999;
}

/* ========== 趋势图 ========== */
.chart-wrap {
  width: 100%;
  height: 400rpx;
}

.trend-canvas {
  width: 100%;
  height: 400rpx;
}

.chart-hint {
  font-size: 20rpx;
  color: #C0B0B0;
  text-align: center;
  margin-top: 12rpx;
}

/* ========== 日间波动卡片 ========== */
.fluct-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.fluct-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: #F3EFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.fluct-info {
  flex: 1;
  min-width: 0;
}

.fluct-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #555;
  display: block;
}

.fluct-desc {
  font-size: 20rpx;
  color: #C0B0B0;
  display: block;
  margin-top: 6rpx;
  line-height: 1.5;
}

.fluct-value {
  font-size: 34rpx;
  font-weight: 800;
  color: #9B59B6;
  flex-shrink: 0;
}

/* ========== 下载按钮 ========== */
.download-btn {
  font-size: 24rpx;
  color: #FF6B81;
  border: 2rpx solid #FFDCE0;
  border-radius: 28rpx;
  padding: 8rpx 22rpx;
  background: linear-gradient(135deg, #FFF5F7, #FFFAFB);
}

.download-btn:active {
  background: #FF6B81;
  color: #FFFFFF;
  border-color: #FF6B81;
}

/* ========== 离屏导出画布 ========== */
.export-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 350px;
  height: 230px;
}

/* ========== 下载弹窗 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal {
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 36rpx 32rpx;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.15);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  display: block;
  text-align: center;
}

.modal-sub {
  font-size: 24rpx;
  color: #B0A0A0;
  display: block;
  text-align: center;
  margin-top: 10rpx;
  margin-bottom: 28rpx;
}

.range-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.range-option {
  flex: 1;
  min-width: 28%;
  text-align: center;
  font-size: 26rpx;
  color: #999;
  background: #FFF5F7;
  border: 2rpx solid #FFE0E4;
  border-radius: 16rpx;
  padding: 18rpx 0;
}

.range-active {
  color: #FFFFFF;
  background: linear-gradient(135deg, #FF6B81, #FF8A9E);
  border-color: #FF6B81;
  font-weight: 600;
}

.custom-range {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.custom-picker {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #C0B0B0;
  background: #FFF9FA;
  border: 2rpx solid #FFE0E4;
  border-radius: 16rpx;
  padding: 18rpx 0;
}

.custom-picked {
  color: #FF6B81;
  font-weight: 500;
  border-color: #FF6B81;
}

.custom-sep {
  font-size: 24rpx;
  color: #B0A0A0;
}

.modal-download-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #FF6B81, #FF8A9E);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  text-align: center;
  margin-top: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 129, 0.3);
}

.modal-download-btn[disabled] {
  background: #F0E0E0;
  color: #CCC;
  box-shadow: none;
}

.modal-cancel {
  text-align: center;
  font-size: 26rpx;
  color: #B0A0A0;
  padding: 24rpx 0 8rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.legend-item text {
  font-size: 20rpx;
  color: #999;
}

.legend-line {
  width: 28rpx;
  height: 6rpx;
  border-radius: 3rpx;
}

.legend-dash {
  border: none;
  background: repeating-linear-gradient(90deg, #9B59B6 0 6rpx, transparent 6rpx 12rpx);
}

/* ========== 记录列表 ========== */
.clear-btn {
  font-size: 24rpx;
  color: #FF6B81;
  padding: 4rpx 16rpx;
  border: 2rpx solid #FFDCE0;
  border-radius: 24rpx;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #FFF9FA;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
}

.record-left {
  flex: 1;
}

.record-date {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.record-period {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 6rpx;
}

.period-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
}

.tag-morning {
  color: #FF9F43;
  background: #FFF3E2;
}

.tag-daytime {
  color: #8E8E9E;
  background: #EFEFF4;
}

.record-time {
  font-size: 20rpx;
  color: #B0A0A0;
}

.record-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.record-weight {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF6B81;
}

.record-unit {
  font-size: 20rpx;
  color: #B0A0A0;
  margin-left: 4rpx;
}

.delete-btn {
  font-size: 22rpx;
  color: #999;
  background: #F0E8E8;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.delete-btn:active {
  background: #FFE0E4;
  color: #FF6B81;
}

/* ========== 空状态 ========== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.empty-emoji {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  font-weight: 600;
}

.empty-sub {
  font-size: 24rpx;
  color: #C0B0B0;
  text-align: center;
  margin-top: 12rpx;
  line-height: 1.6;
}
