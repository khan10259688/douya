/**app.wxss**/
page {
  background: linear-gradient(180deg, #FFF5F7 0%, #FFFAFB 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
  min-height: 100vh;
}

button {
  background: initial;
  padding: 0;
  margin: 0;
  line-height: 1;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}
